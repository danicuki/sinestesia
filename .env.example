# Copy to .env and fill in

# Required
ELEVENLABS_API_KEY=
FAL_API_KEY=

# Optional: also fill in to enable A/B comparison
DEEPGRAM_API_KEY=

# STT mode: "elevenlabs" | "deepgram" | "both" (default: elevenlabs)
STT_PROVIDER=elevenlabs

# Image generator
# "fal"          → fal.ai Flux Schnell (fastest; needs FAL_API_KEY, paid)
# "google"       → Google Imagen 4 Fast (high quality; needs GOOGLE_API_KEY from aistudio.google.com)
# "pollinations" → Pollinations.ai (Flux, free, no key)
IMAGE_PROVIDER=fal

# Director LLM (text → image prompt)
# "gemma"  → local Ollama (sovereign, ~800ms; needs OLLAMA_URL and OLLAMA_MODEL)
# "gemini" → Google Gemini 2.5 Flash via API (~300-500ms; needs GOOGLE_API_KEY)
# "haiku"  → Claude Haiku 4.5 via API (~300ms; needs ANTHROPIC_API_KEY)
# If the primary fails (timeout/error), the dispatcher tries the others in order.
DIRECTOR_PROVIDER=gemma

# Get GOOGLE_API_KEY at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Local Ollama for the Director (Gemma 4 12B MLX)
# Make sure `ollama serve` is running and `ollama pull gemma4:12b-mlx` is done.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:12b-mlx

# Optional fallback if Gemma times out (>1500ms). Leave blank to disable fallback.
ANTHROPIC_API_KEY=

# Optional
PORT=4000
