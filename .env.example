# 🌐 SINESTESIA - ROOT CONFIGURATION TEMPLATE
# Copy this file to '.env' at the project root and fill in your keys.

# ==============================================================================
# 🔑 1. SERVICE API KEYS (REQUIRED FOR CLOUD INTEGRATIONS)
# ==============================================================================

# ElevenLabs (Required for ElevenLabs Scribe STT)
ELEVENLABS_API_KEY=

# fal.ai (Required for high-speed cloud image generation)
FAL_API_KEY=

# Google AI Studio (Required for Gemini Director & Imagen 4 Image Provider)
# Get your key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Anthropic Console (Optional: Claude Haiku fallback / Director)
ANTHROPIC_API_KEY=

# Cloudflare (Optional: if using Cloudflare Workers AI image provider)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ==============================================================================
# 🎙️ 2. SPEECH-TO-TEXT (STT) SELECTOR & CONTROLS
# ==============================================================================

# STT_PROVIDER options:
#   "elevenlabs"     → Cloud ElevenLabs Scribe v2 (Standard default)
#   "deepgram"       → Cloud Deepgram Nova-3
#   "both"           → Streams to BOTH simultaneously for side-by-side comparison
#   "local_whisper"  → Offline MLX-accelerated Whisper sidecar (port 8002)
#   "replay"         → Headless replay (for development & offline compilation)
STT_PROVIDER=elevenlabs

# ElevenLabs Speech-to-Text Advanced tuning
ELEVEN_MODEL=scribe_v2_realtime
ELEVEN_LANG=pt
ELEVEN_COMMIT=vad
ELEVEN_VAD_SILENCE=0.6

# Local Whisper Sidecar Settings (Used when STT_PROVIDER=local_whisper)
LOCAL_WHISPER_HOST=127.0.0.1
LOCAL_WHISPER_PORT=8002
LOCAL_WHISPER_PATH=/transcribe

# ==============================================================================
# 🎬 3. DIRECTOR LLM CONFIGURATION
# ==============================================================================

# DIRECTOR_PROVIDER options:
#   "gemma"  → Local Ollama (Sovereign, MLX-accelerated Gemma 4 12B)
#   "gemini" → Cloud Google Gemini 2.5 Flash API
#   "haiku"  → Cloud Anthropic Claude 4.5 Haiku API
# Note: If the primary fails or times out (>1500ms), the pipeline auto-fails over.
DIRECTOR_PROVIDER=gemma

# Gemma local Ollama configurations
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:12b-mlx

# Gemini configurations
GEMINI_MODEL=gemini-3.1-flash-lite

# LLM history context (number of preceding lyric lines to keep in context)
SCENE_WINDOW=5

# How often to trigger a style pass to re-harmonize colors and canvas drift (integer)
STYLE_REFRESH_EVERY=4

# Style anchor configuration:
#   "none"   → Off (keeps generation extremely free and dynamic)
#   "first"  → Appends the style's first comma-clause to every frame prompt
#   "custom" → Appends a custom string (e.g. "flat painted illustration")
STYLE_ANCHOR=none

# Minimum pacing gate between consecutive image prompts in milliseconds (0 = no wait)
DIRECTOR_MIN_INTERVAL_MS=0

# ==============================================================================
# 🎨 4. IMAGE GENERATION PROVIDERS & CANVAS MODES
# ==============================================================================

# IMAGE_PROVIDER options:
#   "fal"          → Cloud fal.ai Flux (Flux Schnell first frame, Flux Dev for next)
#   "local_sdxl"   → Offline SDXL Turbo local sidecar (highly recommended, port 8003)
#   "google"       → Google Imagen 4 Fast
#   "pollinations" → Free Pollinations.ai (No key required, slower)
#   "cloudflare"   → Cloudflare Workers AI stable diffusion img2img
IMAGE_PROVIDER=fal

# IMAGE_MODE options:
#   "story"   → Accumulative image-to-image (drawing grows/morphs sequentially)
#   "classic" → Independent text-to-image per line (no accumulation)
IMAGE_MODE=story

# RENDER_MODE options:
#   "img2img" → Standard sequential image-to-image
#   "txt2img" → Forces pure text-to-image on every frame
RENDER_MODE=img2img

# Override the Google Imagen model id (default imagen-4.0-fast-generate-001).
# GOOGLE_IMAGE_MODEL=imagen-4.0-fast-generate-001

# "instant ramen" Google model id, benchmarked via the `ramen` provider in
# `mix sinestesia.bench image`. Uses the Gemini :generateContent image API.
# Shipped as gemini-3.1-flash-lite-image (lite/fast variant); `models/` prefix
# is optional.
# GOOGLE_RAMEN_MODEL=gemini-3.1-flash-lite-image

# COMPOSE_MODE options:
#   "inpaint" → Ellipse inpainting on a 3x3 grid (guarantees lyric element legibility)
#   "global"  → Traditional whole-canvas image-to-image transition
COMPOSE_MODE=inpaint

# Enable/disable slerp latent transition frames for local SDXL image-generation
LOCAL_MORPH=true

# Atmospheric/style pass strength (kept low to avoid erasing inpainted elements)
COMPOSE_ATMOS_STRENGTH=0.4

# ==============================================================================
# ⚡ 5. LOCAL SDXL & CLOUDFLARE PARAMETERS
# ==============================================================================

# Local SDXL Sidecar (Used when IMAGE_PROVIDER=local_sdxl)
LOCAL_SDXL_URL=http://127.0.0.1:8003
LOCAL_SDXL_STRENGTH=0.78
LOCAL_SDXL_STEPS=3

# Cloudflare Workers AI parameters (Used when IMAGE_PROVIDER=cloudflare)
CLOUDFLARE_STRENGTH=0.7
CLOUDFLARE_STEPS=20
CLOUDFLARE_GUIDANCE=7.5
CLOUDFLARE_IMG2IMG_MODEL=@cf/runwayml/stable-diffusion-v1-5-img2img
# t2i model: SDXL-Lightning by default (accepts width/height → true 16:9).
# flux-1-schnell has no width/height and only emits 1024x1024 squares.
CLOUDFLARE_T2I_MODEL=@cf/bytedance/stable-diffusion-xl-lightning
CLOUDFLARE_T2I_STEPS=6
# Output dimensions (16:9 to match fal/local). Workers AI SDXL accepts 256..2048.
CLOUDFLARE_WIDTH=1024
CLOUDFLARE_HEIGHT=576

# ==============================================================================
# 📡 6. SYSTEM NETWORKING & REPLAY CONFIG
# ==============================================================================

# Core backend server port
PORT=4000

# Headless Replay Simulator Port
REPLAY_PORT=4999
