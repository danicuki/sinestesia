# Sui network: testnet | devnet | mainnet | localnet
SUI_NETWORK=testnet

# Optional custom fullnode (defaults to the network's public fullnode).
# The default https://fullnode.testnet.sui.io:443 can 404 for JSON-RPC from some
# networks/IPs; if `npm run mint` fails with "Unexpected status code: 404", set
# a working RPC here. This one is verified working:
# SUI_FULLNODE_URL=https://rpc-testnet.suiscan.xyz

# Published package id of sinestesia_nft (from `sui client publish`)
SUI_PACKAGE_ID=0x...

# bech32 secret key of the minting account (from `npm run keygen`)
SUI_SECRET_KEY=suiprivkey1...

# Walrus endpoints (public testnet defaults shown; override for other nets)
WALRUS_PUBLISHER=https://publisher.walrus-testnet.walrus.space
WALRUS_AGGREGATOR=https://aggregator.walrus-testnet.walrus.space
WALRUS_EPOCHS=5
