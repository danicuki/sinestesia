# 0G Compute sidecar configuration

# EVM RPC for the 0G testnet (chain the broker settles payments on).
ZG_RPC=https://evmrpc-testnet.0g.ai

# Private key of the wallet that pays for inference (0G testnet tokens).
# Get testnet 0G from the faucet, then `npm run setup` funds the ledger.
# NEVER commit the real key — this file is .env.example only.
ZG_PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Verifiable inference provider (TEE/TeeML — cryptographically attestable).
# Provider addresses are DYNAMIC; run `npm run providers` to list what's live.
# As of this writing the live verifiable CHAT provider is qwen2.5-omni-7b below.
# (The image-edit provider 0x4b2a…4389 is for images, not the Director.)
ZG_PROVIDER=0xa48f01287233509FD694a22Bf840225062E67836

# Optional: pin a specific model on a multi-model provider. Empty = provider default.
ZG_MODEL=

# Verifiable IMAGE provider, used only by `npm run bench:image` to test whether
# 0G is fast/good enough to drive the visuals too. Confirm live with
# `npm run providers` (qwen-image-edit at time of writing).
ZG_IMAGE_PROVIDER=0x4b2a941929E39Adbea5316dDF2B9Bd8Ff3134389

# How much (in 0G) `npm run setup` deposits into the ledger on first run.
ZG_DEPOSIT=0.1

# Local port the Elixir Director POSTs to (OpenAI-compatible endpoint).
ZG_PORT=8788
